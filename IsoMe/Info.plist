<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>NSSupportsLiveActivities</key>
    <true/>
    
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>isome</string>
                <string>whereday</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.bontecou.isome</string>
        </dict>
    </array>
    
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Whereday needs always-on location access to automatically record the places you visit throughout the day, even when the app is in the background. This enables visit detection and travel tracking.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Whereday needs location access to show your current location and record visits when the app is open.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Whereday can connect geotagged photos to your private map and outings. Photo files stay in your Photos library; Whereday stores only local metadata on-device.</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.bontecou.isome.refresh</string>
        <string>com.bontecou.isome.dailyexport</string>
    </array>
    <key>NSMicrophoneUsageDescription</key>
    <string>Record narration when you start a Scrawl development capture.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Send Scrawl development recordings to your paired Mac.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
