    "Connecting Photos lets iso.me show pictures taken during this outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح ربط الصور iso.me عرض الصور التي تم التقاطها أثناء هذه النزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কানেক্ট করা ফটোগুলি iso.me এই আউটিংয়ের সময় তোলা ছবিগুলি দেখাতে দেয়৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos lets iso.me show pictures taken during this outing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos permite iso.me mostrar fotografías tomadas durante esta excursión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos permet à iso.me d'afficher les photos prises lors de cette sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो कनेक्ट करने से iso.me इस सैर के दौरान ली गई तस्वीरें दिखा सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を接続すると、 iso.meにこの外出中に撮影した写真が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar fotos permite que iso.me mostre fotos tiradas durante este passeio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение фотографий позволяет iso.me показывать фотографии, сделанные во время этой прогулки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接照片可让iso.me显示这次郊游期间拍摄的照片。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z biblioteką Zdjęć pozwala iso.me wyświetlać zdjęcia z tej podróży."
          }
        }
      }
    },
