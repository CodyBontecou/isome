    "Routes with start and end markers plus optional detail points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسارات مع علامات البداية والنهاية بالإضافة إلى نقاط تفصيلية اختيارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু এবং শেষ মার্কার এবং ঐচ্ছিক বিশদ পয়েন্ট সহ রুট।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes with start and end markers plus optional detail points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutas con marcadores de inicio y fin más puntos de detalle opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinéraires avec marqueurs de début et de fin et points de détail facultatifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरंभ और अंत मार्करों के साथ-साथ वैकल्पिक विवरण बिंदुओं वाले मार्ग।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始マーカーと終了マーカーとオプションの詳細ポイントを含むルート。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotas com marcadores de início e fim, além de pontos de detalhe opcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршруты с маркерами начала и конца, а также дополнительными точками детализации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
