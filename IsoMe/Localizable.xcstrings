            "state": "translated",
            "value": "Utiliser l'emplacement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान का उपयोग करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を使用する"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar localização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать местоположение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用地点"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj lokalizacji"
          }
        }
      }
    },
    "Use Test Connection to verify the endpoint URL and credentials without sending real data. Send Now posts all saved location data to the endpoint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اختبار الاتصال للتحقق من URL لنقطة النهاية وبيانات الاعتماد دون إرسال بيانات حقيقية. يقوم تطبيق Send Now بنشر كافة بيانات الموقع المحفوظة إلى نقطة النهاية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আসল ডেটা না পাঠিয়ে শেষ পয়েন্ট URL এবং শংসাপত্র যাচাই করতে পরীক্ষা সংযোগ ব্যবহার করুন। Send Now সব সংরক্ষিত অবস্থানের ডেটা শেষ পয়েন্টে পোস্ট করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Test Connection to verify the endpoint URL and credentials without sending real data. Send Now posts all saved location data to the endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice Test Connection para verificar la URL del punto final y las credenciales sin enviar datos reales. Enviar ahora publica todos los datos de ubicación guardados en el punto final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Test Connection pour vérifier l’ URL et les informations d’identification du point de terminaison sans envoyer de données réelles. Envoyer maintenant publie toutes les données de localisation enregistrées sur le point de terminaison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक डेटा भेजे बिना एंडपॉइंट URL और क्रेडेंशियल्स को सत्यापित करने के लिए टेस्ट कनेक्शन का उपयोग करें। अभी भेजें सभी सहेजे गए स्थान डेटा को अंतिम बिंदु पर पोस्ट करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト接続を使用して、実際のデータを送信せずにエンドポイントURLと資格情報を検証します。 Send Now は、保存されているすべての位置データをエンドポイントに送信します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Test Connection para verificar o URL e as credenciais do endpoint sem enviar dados reais. Enviar agora publica todos os dados de localização salvos no endpoint."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте тестовое соединение, чтобы проверить URL конечной точки и учетные данные без отправки реальных данных. Функция «Отправить сейчас» отправляет все сохраненные данные о местоположении в конечную точку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用测试连接来验证端点URL和凭据，而无需发送真实数据。立即发送将所有保存的位置数据发布到端点。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj połączenia testowego, aby zweryfikować URL punktu końcowego i poświadczenia bez wysyłania prawdziwych danych. Wyślij teraz wysyła wszystkie zapisane dane o lokalizacji do punktu końcowego."
          }
        }
      }
    },
