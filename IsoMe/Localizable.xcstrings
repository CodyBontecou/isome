    "Background visit detection lets iso.me keep recording when the app is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح اكتشاف الزيارة في الخلفية iso.me الاستمرار في التسجيل عند إغلاق التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ড ভিজিট ডিটেকশন iso.me অ্যাপ বন্ধ হয়ে গেলে রেকর্ডিং রাখতে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background visit detection lets iso.me keep recording when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de visitas en segundo plano permite iso.me seguir grabando cuando la aplicación está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des visites en arrière-plan permet à iso.me de continuer à enregistrer lorsque l'application est fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड विज़िट डिटेक्शन से ऐप बंद होने पर iso.me रिकॉर्डिंग जारी रखने की सुविधा मिलती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド訪問検出により、 iso.meアプリを閉じても記録を継続できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção de visitas em segundo plano permite que iso.me continue gravando quando o aplicativo é fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружение фоновых посещений позволяет iso.me продолжать запись, когда приложение закрыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台访问检测让iso.me在应用程序关闭时继续记录。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykrywanie wizyt w tle pozwala iso.me rejestrować dane, gdy aplikacja jest zamknięta."
          }
        }
      }
    },
    "Background visit detection requires extended location access so iso.me keeps recording when the app is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب اكتشاف الزيارة في الخلفية وصولاً ممتدًا إلى الموقع، لذا يستمر iso.me في التسجيل عند إغلاق التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ড ভিজিট ডিটেকশনের জন্য বর্ধিত লোকেশন অ্যাক্সেসের প্রয়োজন হয় তাই অ্যাপ বন্ধ থাকা অবস্থায় iso.me রেকর্ডিং রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background visit detection requires extended location access so iso.me keeps recording when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de visitas en segundo plano requiere acceso extendido a la ubicación, por lo que iso.me sigue grabando cuando la aplicación está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des visites en arrière-plan nécessite un accès étendu à la localisation afin iso.me continue d'enregistrer lorsque l'application est fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि विज़िट का पता लगाने के लिए विस्तारित स्थान पहुंच की आवश्यकता होती है, इसलिए ऐप बंद होने पर iso.me रिकॉर्डिंग करता रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでの訪問検出には拡張位置アクセスが必要なため、アプリを閉じてもiso.me記録を継続します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção de visitas em segundo plano requer acesso estendido à localização, portanto iso.me continua gravando quando o aplicativo é fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обнаружения фоновых посещений требуется расширенный доступ к местоположению, поэтому iso.me продолжает запись, когда приложение закрыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台访问检测需要扩展位置访问权限，因此iso.me在应用程序关闭时会持续记录。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykrywanie wizyt w tle wymaga rozszerzonego dostępu do lokalizacji, aby iso.me mogło rejestrować dane, gdy aplikacja jest zamknięta."
          }
        }
      }
    },
