    "Grant location access in iPhone Settings → iso.me → Location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الوصول إلى الموقع في إعدادات iPhone → iso.me → الموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone সেটিংস → iso.me → অবস্থানে অবস্থান অ্যাক্সেস মঞ্জুর করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant location access in iPhone Settings → iso.me → Location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgue acceso a la ubicación en Configuración iPhone → iso.me → Ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l'accès à la localisation dans Paramètres iPhone → iso.me → Localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone सेटिंग्स → iso.me → स्थान में स्थान पहुंच प्रदान करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 「設定」→ iso.me 」→「位置情報」で位置情報へのアクセスを許可します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso à localização em Configurações iPhone → iso.me → Localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте доступ к местоположению в настройках iPhone → iso.me → Местоположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在iPhone设置 → iso.me → 位置中授予位置访问权限。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj dostęp do lokalizacji w Ustawieniach iPhone → iso.me → Lokalizacja."
          }
        }
      }
    },
