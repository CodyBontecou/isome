    "Export is unlocked forever. Manage your plan or Apple Family Sharing here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح التصدير إلى الأبد. أدِر خطتك أو المشاركة العائلية من Apple هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট চিরকালের জন্য আনলক। এখানে আপনার প্ল্যান বা Apple ফ্যামিলি শেয়ারিং পরিচালনা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export is unlocked forever. Manage your plan or Apple Family Sharing here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación está desbloqueada para siempre. Gestiona aquí tu plan o En familia de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export est débloqué à vie. Gérez ici votre formule ou le partage familial Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट हमेशा के लिए अनलॉक है। अपना प्लान या Apple फ़ैमिली शेयरिंग यहाँ मैनेज करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し機能は無期限で有効です。ここでプランやAppleのファミリー共有を管理できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação está desbloqueada para sempre. Gerencie aqui seu plano ou o Compartilhamento Familiar da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт разблокирован навсегда. Здесь можно управлять планом и Семейным доступом Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出功能已永久解锁。可在此管理方案或 Apple 家人共享。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport jest odblokowany na zawsze. Tutaj możesz zarządzać planem i Chmurą rodzinną Apple."
          }
        }
      }
    },
    "Tracking is free and unlimited. Choose an Individual or Family one-time purchase for data export.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع مجاني وغير محدود. اختر شراءً لمرة واحدة للفرد أو العائلة لتصدير البيانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাকিং বিনামূল্যে ও সীমাহীন। ডেটা এক্সপোর্টের জন্য ইন্ডিভিজুয়াল বা ফ্যামিলি এককালীন কেনাকাটা বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is free and unlimited. Choose an Individual or Family one-time purchase for data export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento es gratuito e ilimitado. Elige una compra única Individual o Familiar para exportar datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi est gratuit et illimité. Choisissez un achat unique Individuel ou Famille pour exporter vos données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैकिंग मुफ़्त और असीमित है। डेटा एक्सपोर्ट के लिए इंडिविजुअल या फ़ैमिली एकमुश्त खरीद चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡は無料かつ無制限です。データの書き出しには個人向けまたはファミリー向けの買い切り版を選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento é gratuito e ilimitado. Escolha uma compra única Individual ou Família para exportar dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание бесплатно и без ограничений. Для экспорта данных выберите разовую индивидуальную или семейную покупку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置记录免费且不限量。数据导出可选择个人或家庭一次性购买。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie jest bezpłatne i nieograniczone. Wybierz jednorazowy zakup indywidualny lub rodzinny do eksportu danych."
          }
        }
      }
    },
