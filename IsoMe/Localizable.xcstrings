    "Location data will be POSTed to the configured endpoint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم نشر بيانات الموقع إلى نقطة النهاية التي تم تكوينها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থানের ডেটা কনফিগার করা শেষ পয়েন্টে পোস্ট করা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location data will be POSTed to the configured endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de ubicación se publicarán en el punto final configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de localisation seront POSTées sur le point de terminaison configuré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान डेटा कॉन्फ़िगर किए गए समापन बिंदु पर पोस्ट किया जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置データは、構成されたエンドポイントに POST されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de localização serão POSTados no endpoint configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о местоположении будут отправлены POST на настроенную конечную точку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置数据将被发布到配置的端点。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane o lokalizacji zostaną wysłane do skonfigurowanego punktu końcowego."
