    "See visits, distance, location points, current location, and remaining session time right on the watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد الزيارات والمسافة ونقاط الموقع والموقع الحالي ووقت الجلسة المتبقي مباشرة على الساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরাসরি ঘড়িতে ভিজিট, দূরত্ব, অবস্থান পয়েন্ট, বর্তমান অবস্থান এবং অবশিষ্ট সেশনের সময় দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See visits, distance, location points, current location, and remaining session time right on the watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea visitas, distancia, puntos de ubicación, ubicación actual y tiempo restante de la sesión directamente en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les visites, la distance, les points de localisation, la position actuelle et la durée restante de la session directement sur la montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे घड़ी पर विज़िट, दूरी, स्थान बिंदु, वर्तमान स्थान और शेष सत्र का समय देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問数、距離、ロケーションポイント、現在位置、セッションの残り時間を時計上で確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja visitas, distância, pontos de localização, localização atual e tempo restante da sessão diretamente no relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте посещения, расстояние, точки местоположения, текущее местоположение и оставшееся время сеанса прямо на часах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在手表上查看访问次数、距离、位置点、当前位置和剩余会话时间。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz wizyty, dystans, punkty lokalizacji, bieżącą lokalizację i pozostały czas sesji bezpośrednio na zegarku."
          }
        }
      }
    },
    "Select a date range with at least two path points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد نطاقًا زمنيًا يشتمل على نقطتي مسار على الأقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপক্ষে দুটি পাথ পয়েন্ট সহ একটি তারিখ ব্যাপ্তি নির্বাচন করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a date range with at least two path points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un rango de fechas con al menos dos puntos de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une plage de dates avec au moins deux points de chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम दो पथ बिंदुओं वाली दिनांक सीमा चुनें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 2 つのパス ポイントがある日付範囲を選択します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um período com pelo menos dois pontos de caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите диапазон дат, в котором есть хотя бы две точки пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择至少包含两个路径点的日期范围。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zakres dat zawierający co najmniej dwa punkty ścieżki."
          }
        }
      }
    },
