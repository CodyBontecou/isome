            "state": "translated",
            "value": "IsoMe এখন ট্র্যাক করছে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe isn't tracking right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe no está rastreando en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe ne suit pas pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe अभी ट्रैकिंग नहीं कर रहा है."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe は現在追跡していません。"
