            "value": "Utiliser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj"
          }
        }
      }
    },
    "Use {title} or {name} in export paths, and iso.me keeps one-file-per-outing exports distinct automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم {title} أو {name} في مسارات التصدير، وسيحافظ iso.me على تمييز عمليات التصدير لكل ملف واحد تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট পাথগুলিতে {title} বা {name} ব্যবহার করুন, এবং iso.me এক-ফাইল-প্রতি-আউটিং এক্সপোর্টগুলিকে স্বয়ংক্রিয়ভাবে আলাদা করে রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {title} or {name} in export paths, and iso.me keeps one-file-per-outing exports distinct automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice {title} o {name} en las rutas de exportación e iso.me mantiene diferenciadas automáticamente las exportaciones de un archivo por salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {title} ou {name} dans les chemins d'exportation, et iso.me conserve automatiquement les exportations d'un fichier par sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात पथों में {title} या {name} उपयोग करें, और iso.me एक-फ़ाइल-प्रति-आउटिंग निर्यात को स्वचालित रूप से अलग रखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート パスで{title}または{name}を使用すると、 iso.me出力ごとに 1 つのファイルのエクスポートを自動的に区別します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {title} ou {name} nos caminhos de exportação e iso.me mantém as exportações de um arquivo por saída distintas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {title} или {name} в путях экспорта, и iso.me автоматически разделит экспорт по одному файлу на каждый исходящий файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在导出路径中使用{title}或{name} ， iso.me会自动保持每次导出一个文件的导出不同。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {title} lub {name} w ścieżkach eksportu, a iso.me automatycznie rozróżnia eksporty jednego pliku na wyjście."
          }
        }
      }
    },
    "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم / للمجلدات. الرموز: %@ . {title} / {name} استخدم عنوان النزهة عندما يكون متاحًا، وإلا نوع البيانات. تتم إضافة ملحق التنسيق إذا تم حذفه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের জন্য / ব্যবহার করুন। টোকেন: %@ । {title} / {name} উপলভ্য হলে আউটিং শিরোনাম ব্যবহার করুন, অন্যথায় ডেটা টাইপ। বাদ দিলে ফরম্যাট এক্সটেনশন যোগ করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice / para carpetas. Fichas: %@ . {title} / {name} usa el título de la salida cuando esté disponible; de ​​lo contrario, el tipo de datos. La extensión de formato se agrega si se omite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez / pour les dossiers. Jetons : %@ . {title} / {name} utilise le titre de la sortie lorsqu'il est disponible, sinon le type de données. L'extension de format est ajoutée si elle est omise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डरों के लिए / का उपयोग करें. टोकन: %@ . {title} / {name} उपलब्ध होने पर आउटिंग शीर्षक का उपयोग करें, अन्यथा डेटा प्रकार का। यदि छोड़ा गया है तो प्रारूप एक्सटेंशन जोड़ा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーには / を使用します。トークン: %@ 。 {title} / {name}利用可能な場合は外出のタイトルを使用し、それ以外の場合はデータ型を使用します。省略した場合はフォーマット拡張子が付加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use / para pastas. Tokens: %@ . {title} / {name} use o título do passeio quando disponível, caso contrário, o tipo de dados. A extensão de formato é adicionada se for omitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте / для папок. Токены: %@ . {title} / {name} использует заголовок выхода, если он доступен, в противном случае — тип данных. Расширение формата добавляется, если оно опущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 表示文件夹。代币： %@ 。 {title} / {name}使用郊游标题（如果可用），否则使用数据类型。如果省略，则会添加格式扩展名。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj / dla folderów. Tokeny: %@. {title} / {name} użyj tytułu podróży, jeśli jest dostępny, w przeciwnym razie typ danych. W przypadku pominięcia dodawane jest rozszerzenie formatu."
          }
        }
      }
    },
    "Use current location instead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الموقع الحالي بدلاً من ذلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবর্তে বর্তমান অবস্থান ব্যবহার করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use current location instead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la ubicación actual en su lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser plutôt l'emplacement actuel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय वर्तमान स्थान का उपयोग करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに現在の場所を使用してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a localização atual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого используйте текущее местоположение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前位置代替"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast tego użyj bieżącej lokalizacji"
          }
        }
      }
    },
    "Use inferred movement to fill older days from GPS points that were saved before exact start/stop sessions existed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الحركة المستنتجة لملء الأيام القديمة من نقاط GPS التي تم حفظها قبل وجود جلسات البدء/الإيقاف المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক স্টার্ট/স্টপ সেশন বিদ্যমান থাকার আগে সংরক্ষিত GPS পয়েন্ট থেকে পুরানো দিনগুলি পূরণ করতে অনুমানকৃত আন্দোলন ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use inferred movement to fill older days from GPS points that were saved before exact start/stop sessions existed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el movimiento inferido para completar días más antiguos a partir de puntos GPS que se guardaron antes de que existieran las sesiones exactas de inicio/parada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les mouvements déduits pour remplir les jours plus anciens à partir des points GPS enregistrés avant que les sessions de démarrage/arrêt exactes n'existent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS बिंदुओं से पुराने दिनों को भरने के लिए अनुमानित आंदोलन का उपयोग करें जो सटीक प्रारंभ/स्टॉप सत्र मौजूद होने से पहले सहेजे गए थे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定された動きを使用して、正確な開始/停止セッションが存在する前に保存されたGPSポイントから古い日数を埋めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o movimento inferido para preencher dias mais antigos a partir de pontos GPS que foram salvos antes da existência de sessões exatas de início/parada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте предполагаемое движение для заполнения более старых дней на основе точек GPS , которые были сохранены до того, как существовали точные сеансы начала/остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用推断的运动来根据精确开始/停止会话存在之前保存的GPS点来填补过去的日子。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz szacowanie przemieszczeń, aby uzupełnić starsze dni na podstawie punktów GPS zapisanych przed wprowadzeniem dokładnych sesji z początkiem i końcem."
          }
        }
      }
    },
    "Use location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام الموقع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান ব্যবহার করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use location"
          }
        },
        "es": {
          "stringUnit": {
