    "Find a business, landmark, or street address, or place a pin at the exact coordinate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن عنوان عمل أو معلم أو شارع، أو ضع دبوسًا على الإحداثيات الدقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ব্যবসা, ল্যান্ডমার্ক, বা রাস্তার ঠিকানা খুঁজুন বা সঠিক স্থানাঙ্কে একটি পিন রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a business, landmark, or street address, or place a pin at the exact coordinate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre una empresa, un punto de referencia o una dirección, o coloque un marcador en la coordenada exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez une entreprise, un point de repère ou une adresse postale, ou placez une épingle aux coordonnées exactes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई व्यवसाय, मील का पत्थर, या सड़क का पता ढूंढें, या सटीक निर्देशांक पर एक पिन लगाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジネス、ランドマーク、または番地を検索するか、正確な座標にピンを配置します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre uma empresa, ponto de referência ou endereço, ou coloque um alfinete na coordenada exata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите компанию, достопримечательность или адрес улицы или поместите булавку в точную координату."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找企业、地标或街道地址，或将图钉放置在确切的坐标处。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź firmę, punkt orientacyjny lub adres albo umieść pinezkę na dokładnych współrzędnych."
          }
        }
      }
    },
