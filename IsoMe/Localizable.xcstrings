    "Automatically save one dated file for each local calendar day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تلقائيًا ملفًا واحدًا مؤرخًا لكل يوم تقويمي محلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি স্থানীয় ক্যালেন্ডার দিনের জন্য স্বয়ংক্রিয়ভাবে একটি তারিখযুক্ত ফাইল সংরক্ষণ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically save one dated file for each local calendar day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda automáticamente un archivo fechado por cada día natural local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez automatiquement un fichier daté pour chaque jour civil local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्थानीय कैलेंडर दिन के लिए एक दिनांकित फ़ाइल अपने आप सहेजें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの暦日ごとに、日付付きファイルを1つ自動保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve automaticamente um arquivo datado para cada dia do calendário local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически сохраняйте по одному датированному файлу на каждый локальный календарный день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按本地日历日自动保存一个带日期的文件。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie zapisuj jeden datowany plik na każdy lokalny dzień kalendarzowy."
          }
        }
      }
    },
