    "Restores the automatically detected visit name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة اسم الزيارة المكتشف تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়ভাবে সনাক্ত করা ভিজিট নাম পুনরুদ্ধার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the automatically detected visit name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el nombre de la visita detectada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure le nom de la visite détecté automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रूप से पहचाने गए विज़िट नाम को पुनर्स्थापित करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に検出された訪問名を復元します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o nome da visita detectada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает автоматически определенное имя посещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复自动检测到的访问名称。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca automatycznie wykrytą nazwę wizyty."
          }
        }
      }
    },
