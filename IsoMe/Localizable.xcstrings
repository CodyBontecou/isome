    "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map. Photo dots override this setting without changing it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map. Photo dots override this setting without changing it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje miniatury wewnątrz znaczników zdjęć. Wyłącz tę opcję, aby używać małych pinezek z ikoną aparatu i zachować dostęp do zdjęć na mapie. Punkty zdjęć mają pierwszeństwo przed tą opcją, ale nie zmieniają jej ustawienia."
          }
        }
      }
    },
    "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij miniaturę, aby wyświetlić zdjęcie na pełnym ekranie, a następnie użyj strzałek, aby przeglądać wszystkie zdjęcia z tej grupy."
          }
        }
      }
    },
    "Turn on Photo dots in the map filters for a clearer view of where you took your photos. Your choice is saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Photo dots in the map filters for a clearer view of where you took your photos. Your choice is saved."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz punkty zdjęć w filtrach mapy, aby lepiej widzieć miejsca wykonania zdjęć. Twój wybór zostanie zapamiętany."
          }
        }
      }
    },
    "Uses small dots instead of photo images or camera pins. Larger dots represent grouped photos. Tap a dot to browse; previews load only when you open the photos. Turn this off to restore your image or pin preference.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses small dots instead of photo images or camera pins. Larger dots represent grouped photos. Tap a dot to browse; previews load only when you open the photos. Turn this off to restore your image or pin preference."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa małych punktów zamiast miniatur zdjęć lub pinezek z ikoną aparatu. Większe punkty oznaczają grupy zdjęć. Stuknij punkt, aby je przeglądać; podglądy są wczytywane dopiero po otwarciu zdjęć. Wyłącz tę opcję, aby przywrócić wcześniejszy wybór miniatur lub pinezek."
          }
        }
      }
    },
