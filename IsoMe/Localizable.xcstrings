    "You can grant permission later from the Settings tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك منح الإذن لاحقًا من علامة التبويب \"الإعدادات\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সেটিংস ট্যাব থেকে পরে অনুমতি দিতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission later from the Settings tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede otorgar permiso más tarde desde la pestaña Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez accorder l'autorisation ultérieurement à partir de l'onglet Paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बाद में सेटिंग टैब से अनुमति दे सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で [設定] タブから権限を付与できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conceder permissão posteriormente na guia Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете предоставить разрешение позже на вкладке «Настройки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以稍后从“设置”选项卡授予权限。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz udzielić pozwolenia później na karcie Ustawienia."
          }
        }
      }
    },
    "You can still add details manually": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال بإمكانك إضافة التفاصيل يدويًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও ম্যানুয়ালি বিবরণ যোগ করতে পারেন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still add details manually"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes agregar detalles manualmente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours ajouter des détails manuellement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी भी विवरण मैन्युअल रूप से जोड़ सकते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細を手動で追加することもできます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode adicionar detalhes manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы по-прежнему можете добавить детали вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您仍然可以手动添加详细信息"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal możesz dodawać szczegóły ręcznie"
          }
        }
      }
    },
    "You haven't moved yet today.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لم تتحرك بعد اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি আজও সরে যাওনি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't moved yet today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no te has movido hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas encore bougé aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आज तक अभी तक स्थानांतरित नहीं हुए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
