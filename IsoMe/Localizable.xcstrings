    "Empty days now keep the overview and date picker on screen, with a quick jump back to your latest data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأيام الفارغة الآن تحافظ على النظرة العامة ومنتقي التاريخ على الشاشة، مع الانتقال السريع إلى أحدث بياناتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খালি দিনগুলি এখন ওভারভিউ এবং তারিখ চয়নকারীকে স্ক্রিনে রাখুন, দ্রুত লাফ দিয়ে আপনার সর্বশেষ ডেটাতে ফিরে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty days now keep the overview and date picker on screen, with a quick jump back to your latest data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días vacíos ahora mantienen la descripción general y el selector de fechas en la pantalla, con un salto rápido a los datos más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours vides conservent désormais l'aperçu et le sélecteur de date à l'écran, avec un retour rapide à vos dernières données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली दिन अब अपने नवीनतम डेटा पर त्वरित वापसी के साथ, स्क्रीन पर अवलोकन और दिनांक पिकर रखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空の日には概要と日付ピッカーが画面上に表示され、最新のデータにすぐに戻ることができるようになりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias vazios agora mantêm a visão geral e o seletor de data na tela, com um rápido retorno aos dados mais recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые дни теперь сохраняют обзор и выбор даты на экране с быстрым переходом к последним данным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，空的日子会在屏幕上保留概述和日期选择器，并快速跳回到最新数据。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste dni umożliwiają teraz przeglądanie przeglądu i wybór dat na ekranie, dzięki czemu można szybko wrócić do najnowszych danych."
          }
        }
      }
    },
