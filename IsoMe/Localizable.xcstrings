    "Unable to Check Out": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to Check Out"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل المغادرة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্থান নথিভুক্ত করা যায়নি"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar la salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le départ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्थान दर्ज नहीं हो सका"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退出を記録できません"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zakończyć wizyty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar a saída"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить посещение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法签退"
          }
        }
      }
    },
    "Ends this manual visit at the current time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends this manual visit at the current time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذه الزيارة اليدوية في الوقت الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান সময়ে এই ম্যানুয়াল পরিদর্শন শেষ করে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza esta visita manual a la hora actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine cette visite manuelle à l’heure actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मैन्युअल विज़िट को वर्तमान समय पर समाप्त करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手動の訪問を現在の時刻で終了します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy tę ręcznie dodaną wizytę o bieżącej godzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra esta visita manual no horário atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает это посещение, добавленное вручную, в текущее время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以当前时间结束此次手动添加的到访。"
          }
        }
      }
    },
    "The visit could not be saved. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The visit could not be saved. Please try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الزيارة. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিদর্শন সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la visita. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visite n’a pas pu être enregistrée. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज़िट सहेजी नहीं जा सकी। फिर से प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問を保存できませんでした。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać wizyty. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a visita. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить посещение. Попробуйте ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存到访。请重试。"
          }
        }
      }
    },
    "These times overlap your visit to %@. Review the times or save both visits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These times overlap your visit to %@. Review the times or save both visits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتداخل هذه الأوقات مع زيارتك إلى %@. راجع الأوقات أو احفظ الزيارتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সময়গুলি %@-এ আপনার পরিদর্শনের সঙ্গে মিলে যাচ্ছে। সময়গুলি পর্যালোচনা করুন অথবা উভয় পরিদর্শন সংরক্ষণ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas horas se superponen con tu visita a %@. Revisa las horas o guarda ambas visitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces horaires chevauchent votre visite à %@. Vérifiez les horaires ou enregistrez les deux visites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये समय %@ की आपकी विज़िट से ओवरलैप होते हैं। समय जाँचें या दोनों विज़िट सहेजें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間は%@への訪問と重複しています。時間を確認するか、両方の訪問を保存してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te godziny nakładają się na wizytę w miejscu %@. Sprawdź godziny lub zapisz obie wizyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes horários se sobrepõem à sua visita a %@. Revise os horários ou salve as duas visitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это время пересекается с вашим посещением %@. Проверьте время или сохраните оба посещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时间与您到访%@的时间重叠。请检查时间或保存两次到访。"
          }
        }
      }
    },
