          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু হওয়ার সময় অনুযায়ী মুভমেন্ট খুঁজে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds movements by when they started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra movimientos según cuándo comenzaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve des déplacements selon leur heure de début."
          }
