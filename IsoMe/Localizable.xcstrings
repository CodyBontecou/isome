    "IsoMe needs location permission. Open the app to enable it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج IsoMe إلى إذن الموقع. افتح التطبيق لتمكينه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe-এর লোকেশনের অনুমতি প্রয়োজন। এটি সক্ষম করতে অ্যাপটি খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe needs location permission. Open the app to enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe necesita permiso de ubicación. Abra la aplicación para habilitarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe a besoin d'une autorisation de localisation. Ouvrez l'application pour l'activer."
