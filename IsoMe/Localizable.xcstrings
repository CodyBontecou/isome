    "Recorded sessions now live in a dedicated Outings tab, with totals, live/current status, inferred badges, and quick access to every route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الآن بث الجلسات المسجلة في علامة تبويب مخصصة للنزهات، مع الإجماليات والحالة المباشرة/الحالية والشارات المستنتجة والوصول السريع إلى كل طريق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করা সেশনগুলি এখন একটি ডেডিকেটেড আউটিং ট্যাবে লাইভ, মোট, লাইভ/কারেন্ট স্ট্যাটাস, অনুমান করা ব্যাজ এবং প্রতিটি রুটে দ্রুত অ্যাক্সেস সহ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded sessions now live in a dedicated Outings tab, with totals, live/current status, inferred badges, and quick access to every route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones grabadas ahora se encuentran en una pestaña dedicada a Salidas, con totales, estado en vivo/actual, credenciales inferidas y acceso rápido a cada ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions enregistrées sont désormais disponibles dans un onglet Sorties dédié, avec les totaux, le statut en direct/actuel, les badges déduits et un accès rapide à chaque itinéraire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड किए गए सत्र अब एक समर्पित आउटिंग टैब में रहते हैं, जिसमें कुल योग, लाइव/वर्तमान स्थिति, अनुमानित बैज और हर मार्ग तक त्वरित पहुंच होती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されたセッションは専用の [外出] タブに表示され、合計、ライブ/現在のステータス、推定されたバッジ、およびすべてのルートへのクイック アクセスが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões gravadas agora ficam em uma guia dedicada de Passeios, com totais, status ao vivo/atual, crachás inferidos e acesso rápido a todas as rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанные сеансы теперь хранятся на специальной вкладке «Вылазки» с общими данными, текущим/живым статусом, предполагаемыми значками и быстрым доступом к каждому маршруту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制的会话现在位于专用的“外出”选项卡中，其中包含总计、实时/当前状态、推断徽章以及对每条路线的快速访问。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestrowane sesje są teraz dostępne na osobnej karcie Podróże, z podsumowaniami, bieżącym stanem, oznaczeniami oszacowanych podróży i szybkim dostępem do każdej trasy."
          }
        }
      }
    },
