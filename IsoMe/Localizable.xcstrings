    },
    "Export your visits, points, and routes in JSON, CSV, or Markdown. Tracking stays free and unlimited.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر زياراتك ونقاطك ومساراتك بتنسيق JSON أو CSV أو Markdown. يظل التتبع مجانيًا وغير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভিজিট, পয়েন্ট ও রুট JSON, CSV বা Markdown ফরম্যাটে রপ্তানি করুন। ট্র্যাকিং বিনামূল্যে ও সীমাহীন থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your visits, points, and routes in JSON, CSV, or Markdown. Tracking stays free and unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus visitas, puntos y rutas en JSON, CSV o Markdown. El seguimiento sigue siendo gratuito e ilimitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos visites, points et itinéraires au format JSON, CSV ou Markdown. Le suivi reste gratuit et illimité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी विज़िट, पॉइंट और रूट को JSON, CSV या Markdown में एक्सपोर्ट करें। ट्रैकिंग मुफ़्त और असीमित रहेगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問、地点、ルートをJSON、CSV、Markdown形式で書き出せます。トラッキングは引き続き無料で、制限なく利用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte suas visitas, pontos e rotas em JSON, CSV ou Markdown. O rastreamento continua gratuito e ilimitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте посещения, точки и маршруты в JSON, CSV или Markdown. Отслеживание остаётся бесплатным и без ограничений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将访问记录、位置点和路线导出为 JSON、CSV 或 Markdown。跟踪功能仍然免费且不限量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj swoje wizyty, punkty i trasy w formacie JSON, CSV lub Markdown. Śledzenie pozostaje bezpłatne i nieograniczone."
          }
        }
      }
    },
    "Exports save directly to this folder when auto-save is on. Otherwise the share sheet opens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير الحفظ مباشرة إلى هذا المجلد عند تشغيل الحفظ التلقائي. وإلا سيتم فتح ورقة المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়-সংরক্ষণ চালু থাকলে রপ্তানিগুলি সরাসরি এই ফোল্ডারে সংরক্ষণ করে৷ অন্যথায় শেয়ার শীট খোলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports save directly to this folder when auto-save is on. Otherwise the share sheet opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones se guardan directamente en esta carpeta cuando el guardado automático está activado. De lo contrario, se abre la hoja para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exportations sont enregistrées directement dans ce dossier lorsque l'enregistrement automatique est activé. Sinon, la feuille de partage s'ouvre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो-सेव चालू होने पर सेव को सीधे इस फ़ोल्डर में निर्यात किया जाता है। अन्यथा शेयर शीट खुल जाती है."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保存がオンになっている場合、エクスポートはこのフォルダーに直接保存されます。それ以外の場合は、共有シートが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exportações são salvas diretamente nesta pasta quando o salvamento automático está ativado. Caso contrário, a planilha de compartilhamento será aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует сохранения непосредственно в эту папку, если автосохранение включено. В противном случае откроется лист общего доступа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当自动保存打开时，导出直接保存到此文件夹。否则共享表将打开。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuje zapis bezpośrednio do tego folderu, gdy włączone jest automatyczne zapisywanie. W przeciwnym razie otworzy się arkusz udostępniania."
          }
        }
      }
    },
