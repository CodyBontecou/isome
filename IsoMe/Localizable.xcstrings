    "Export yesterday's IsoMe visits and route as a file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتصدير زيارات IsoMe بالأمس وتوجيهها كملف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গতকালের IsoMe ভিজিট এবং রুট ফাইল হিসাবে রপ্তানি করুন।"
          }
        },
        "en": {
