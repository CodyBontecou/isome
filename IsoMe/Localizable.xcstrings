    "Show an outing on the main map to focus the exact route, start and finish markers, and cleaned-up current visit state.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض نزهة على الخريطة الرئيسية للتركيز على المسار الدقيق وعلامات البداية والنهاية وحالة الزيارة الحالية التي تم تنظيفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক রুট ফোকাস করতে প্রধান মানচিত্রে একটি আউটিং দেখান, মার্কার শুরু এবং শেষ করুন এবং বর্তমান পরিদর্শন অবস্থা পরিষ্কার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show an outing on the main map to focus the exact route, start and finish markers, and cleaned-up current visit state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestre una excursión en el mapa principal para enfocar la ruta exacta, los marcadores de inicio y finalización y el estado actual de la visita limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez une sortie sur la carte principale pour vous concentrer sur l'itinéraire exact, les marqueurs de début et de fin et l'état actuel de la visite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक मार्ग, प्रारंभ और समापन मार्करों और साफ-सुथरी वर्तमान यात्रा स्थिति पर ध्यान केंद्रित करने के लिए मुख्य मानचित्र पर एक सैर दिखाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン マップに外出を表示して、正確なルート、開始マーカーと終了マーカー、およびクリーンアップされた現在の訪問状態に焦点を当てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um passeio no mapa principal para focar a rota exata, marcadores de início e fim e estado atual da visita limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите прогулку на главной карте, чтобы указать точный маршрут, маркеры начала и окончания, а также очистить текущее состояние посещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主地图上显示一次郊游，以关注确切的路线、起点和终点标记，并清理当前的访问状态。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż podróż na głównej mapie, aby skupić się na dokładnej trasie, znacznikach rozpoczęcia i zakończenia oraz uporządkowanym bieżącym stanie wizyty."
          }
        }
      }
    },
