    "Search for a business, landmark, or street address. You can also navigate and tap the map.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن عنوان عمل أو معلم أو شارع. يمكنك أيضًا التنقل والنقر فوق الخريطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ব্যবসা, ল্যান্ডমার্ক, বা রাস্তার ঠিকানা খুঁজুন। এছাড়াও আপনি নেভিগেট করতে পারেন এবং ম্যাপে ট্যাপ করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for a business, landmark, or street address. You can also navigate and tap the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque una empresa, un punto de referencia o una dirección postal. También puedes navegar y tocar el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez une entreprise, un point de repère ou une adresse postale. Vous pouvez également naviguer et appuyer sur la carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवसाय, मील का पत्थर, या सड़क का पता खोजें। आप मानचित्र पर नेविगेट और टैप भी कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジネス、ランドマーク、または番地を検索します。地図をタップして移動することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise uma empresa, ponto de referência ou endereço. Você também pode navegar e tocar no mapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите компанию, достопримечательность или адрес. Вы также можете перемещаться и нажимать на карту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索企业、地标或街道地址。您还可以导航并点击地图。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj firmę, punkt orientacyjny lub adres ulicy. Możesz także nawigować i dotykać mapy."
          }
        }
      }
    },
    "Search for an accessible list of places, or tap the map to move the selected pin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن قائمة الأماكن التي يمكن الوصول إليها، أو اضغط على الخريطة لتحريك الدبوس المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানগুলির একটি অ্যাক্সেসযোগ্য তালিকা অনুসন্ধান করুন, বা নির্বাচিত পিনটি সরাতে মানচিত্রে আলতো চাপুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for an accessible list of places, or tap the map to move the selected pin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque una lista accesible de lugares o toque el mapa para mover el marcador seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez une liste de lieux accessibles ou appuyez sur la carte pour déplacer l'épingle sélectionnée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानों की सुलभ सूची खोजें, या चयनित पिन को स्थानांतरित करने के लिए मानचित्र पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス可能な場所のリストを検索するか、地図をタップして選択したピンを移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procure uma lista acessível de lugares ou toque no mapa para mover o alfinete selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите доступный список мест или коснитесь карты, чтобы переместить выбранную булавку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索可访问的地点列表，或点击地图以移动选定的图钉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj dostępną listę miejsc lub dotknij mapy, aby przesunąć wybrany pinezkę."
          }
        }
      }
    },
    "Search for the place, choose it on the map, or select a saved location.": {
