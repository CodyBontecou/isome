    },
    "Unsupported file format. Import currently supports JSON, CSV, or Markdown files exported from iso.me. KML, GPX, and GeoJSON exports are one-way map files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق الملف غير معتمد. يدعم الاستيراد حاليًا ملفات JSON أو CSV أو Markdown المصدرة من iso.me. تعد عمليات تصدير KML و GPX و GeoJSON عبارة عن ملفات خرائط أحادية الاتجاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অসমর্থিত ফাইল বিন্যাস। আমদানি বর্তমানে iso.me থেকে রপ্তানি করা JSON , CSV , বা Markdown ফাইলগুলিকে সমর্থন করে৷ KML , GPX , এবং GeoJSON রপ্তানি হল একমুখী মানচিত্র ফাইল৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported file format. Import currently supports JSON, CSV, or Markdown files exported from iso.me. KML, GPX, and GeoJSON exports are one-way map files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de archivo no compatible. Actualmente, la importación admite archivos JSON , CSV o Markdown exportados desde iso.me. Las exportaciones KML , GPX y GeoJSON son archivos de mapas unidireccionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de fichier non pris en charge. L'importation prend actuellement en charge les fichiers JSON , CSV ou Markdown exportés depuis iso.me. Les exportations KML , GPX et GeoJSON sont des fichiers cartographiques unidirectionnels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असमर्थित फ़ाइल स्वरूप। आयात वर्तमान में iso.me से निर्यात की गई JSON , CSV , या Markdown फ़ाइलों का समर्थन करता है। KML , GPX , और GeoJSON निर्यात एक-तरफ़ा मानचित्र फ़ाइलें हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていないファイル形式です。 Import は現在、 iso.me からエクスポートされたJSON 、 CSV 、またはMarkdownファイルをサポートしています。 KML 、 GPX 、およびGeoJSONエクスポートは一方向のマップ ファイルです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de arquivo não suportado. Atualmente, a importação oferece suporte a arquivos JSON , CSV ou Markdown exportados de iso.me. As exportações KML , GPX e GeoJSON são arquivos de mapas unidirecionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемый формат файла. В настоящее время импорт поддерживает файлы JSON , CSV или Markdown экспортированные из iso.me. Экспорт KML , GPX и GeoJSON представляет собой односторонние файлы карт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的文件格式。 Import 目前支持从 iso.me 导出的JSON 、 CSV或Markdown文件。 KML 、 GPX和GeoJSON导出是单向地图文件。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwany format pliku. Import obsługuje obecnie pliki JSON, CSV i Markdown eksportowane z iso.me. Eksporty KML, GPX i GeoJSON są jednokierunkowymi plikami map."
          }
        }
      }
    },
