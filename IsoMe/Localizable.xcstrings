    "Departure can’t be before arrival.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تكون المغادرة قبل الوصول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্থান আগমনের আগে হতে পারে না."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departure can’t be before arrival."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida no puede ser antes de la llegada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le départ ne peut pas avoir lieu avant l'arrivée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगमन से पहले प्रस्थान नहीं हो सकता."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着前に出発することはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partida não pode ser antes da chegada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отъезд не может быть раньше прибытия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出发时间不得早于抵达时间。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas wyjścia nie może poprzedzać czasu przybycia."
          }
        }
      }
    },
