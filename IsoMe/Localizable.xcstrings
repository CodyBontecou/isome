    "Wait for the outing path to be matched to roads.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى تتم مطابقة مسار النزهة مع الطرق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আউটিং পাথ রাস্তার সাথে মিলে যাওয়ার জন্য অপেক্ষা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the outing path to be matched to roads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere a que el camino de salida coincida con las carreteras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez que le parcours de sortie soit adapté aux routes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैर के रास्ते के सड़कों से मेल खाने की प्रतीक्षा करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "往路が道路と一致するまで待ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde até que o caminho do passeio corresponda às estradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите, пока путь выхода будет сопоставлен с дорогами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待郊游路径与道路匹配。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj, aż trasa podróży zostanie dopasowana do dróg."
          }
        }
      }
    },
