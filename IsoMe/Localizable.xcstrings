    "Add a visit at your current location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف زيارة إلى موقعك الحالي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বর্তমান অবস্থানে একটি দর্শন যোগ করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a visit at your current location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una visita a tu ubicación actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une visite à votre emplacement actuel"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वर्तमान स्थान पर एक विज़िट जोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の場所への訪問を追加"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma visita em sua localização atual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте посещение вашего текущего местоположения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您当前位置的访问"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wizytę w Twojej aktualnej lokalizacji"
          }
        }
      }
    },
    "Add current or past visits from the map, confirm detected places, or correct them with nearby place suggestions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإضافة الزيارات الحالية أو السابقة من الخريطة، أو تأكيد الأماكن المكتشفة، أو تصحيحها باستخدام اقتراحات الأماكن القريبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানচিত্র থেকে বর্তমান বা অতীতের পরিদর্শন যোগ করুন, সনাক্ত করা স্থানগুলি নিশ্চিত করুন বা কাছাকাছি স্থানের পরামর্শ দিয়ে তাদের সংশোধন করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add current or past visits from the map, confirm detected places, or correct them with nearby place suggestions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue visitas actuales o pasadas desde el mapa, confirme lugares detectados o corríjalos con sugerencias de lugares cercanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les visites actuelles ou passées à partir de la carte, confirmez les lieux détectés ou corrigez-les avec des suggestions de lieux à proximité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानचित्र से वर्तमान या पिछली यात्राओं को जोड़ें, ज्ञात स्थानों की पुष्टि करें, या आस-पास के स्थानों के सुझावों से उन्हें ठीक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図から現在または過去の訪問を追加したり、検出された場所を確認したり、近くの場所の提案で修正したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione visitas atuais ou anteriores do mapa, confirme locais detectados ou corrija-os com sugestões de locais próximos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте текущие или прошлые посещения с карты, подтверждайте обнаруженные места или исправляйте их, предлагая места поблизости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从地图添加当前或过去的访问，确认检测到的地点，或使用附近的地点建议更正它们。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj bieżące lub przeszłe wizyty z mapy, potwierdź wykryte miejsca lub popraw je, korzystając z sugestii miejsc w pobliżu."
          }
        }
      }
    },
    "Add iso.me to supported watch faces for quick tracking status and today’s totals.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف iso.me إلى وجوه الساعة المدعومة للتتبع السريع لحالة وإجماليات اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ট্র্যাকিং স্ট্যাটাস এবং আজকের মোটের জন্য সমর্থিত ঘড়ির মুখগুলিতে iso.me যোগ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add iso.me to supported watch faces for quick tracking status and today’s totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue iso.me a las esferas de reloj compatibles para realizar un seguimiento rápido del estado y los totales de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez iso.me aux cadrans de montre pris en charge pour un suivi rapide de l'état et des totaux du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित ट्रैकिंग स्थिति और आज के कुल योग के लिए समर्थित वॉच फेस में iso.me जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされているウォッチフェイスにiso.meを追加すると、ステータスと今日の合計を簡単に追跡できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione iso.me aos mostradores de relógio compatíveis para rastrear rapidamente o status e os totais de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте iso.me в список поддерживаемых циферблатов, чтобы быстро отслеживать статус и текущие итоги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将iso.me添加到支持的表盘，以快速跟踪状态和今天的总数。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj iso.me do obsługiwanych tarcz zegarka, aby uzyskać szybki status śledzenia i dzisiejsze sumy."
          }
        }
      }
    },
