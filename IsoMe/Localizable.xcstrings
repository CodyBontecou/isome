    "How far you've moved today, according to IsoMe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى انتقلت اليوم، وفقًا لـ IsoMe."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe অনুসারে আপনি আজ কতটা এগিয়ে গেছেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far you've moved today, according to IsoMe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué tan lejos has avanzado hoy, según IsoMe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où vous avez parcouru aujourd'hui, selon IsoMe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe के अनुसार, आज आप कितना आगे बढ़ गए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe によると、今日あなたはどれくらいの距離を移動しましたか。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão longe você avançou hoje, de acordo com o IsoMe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как далеко вы продвинулись сегодня, по данным IsoMe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 IsoMe 的数据，您今天走了多远。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dystans zarejestrowany przez IsoMe."
          }
        }
      }
    },
    "How long the current IsoMe tracking session has been running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي مدة تشغيل جلسة تتبع IsoMe الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান IsoMe ট্র্যাকিং সেশন কতক্ষণ ধরে চলছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the current IsoMe tracking session has been running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo lleva ejecutándose la sesión de seguimiento actual de IsoMe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis combien de temps la session de suivi IsoMe actuelle est-elle en cours d'exécution ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान IsoMe ट्रैकिंग सत्र कितने समय से चल रहा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の IsoMe 追跡セッションが実行されている時間。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há quanto tempo a sessão atual de rastreamento IsoMe está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго длится текущий сеанс отслеживания IsoMe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 IsoMe 跟踪会话已运行多长时间。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo trwa bieżąca sesja śledzenia IsoMe."
          }
        }
      }
    },
