            "state": "translated",
            "value": "使用時"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando em uso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При использовании"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用时"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas używania"
          }
        }
      }
    },
    "When today has no timeline events, iso.me now opens the most recent day with saved visits or movement so your history is easier to review.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما لا يحتوي اليوم على أحداث مخطط زمني، يفتح iso.me الآن آخر يوم بالزيارات أو الحركة المحفوظة بحيث تكون مراجعة السجل الخاص بك أسهل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন আজকের কোনো টাইমলাইন ইভেন্ট নেই, তখন iso.me এখন সংরক্ষিত পরিদর্শন বা আন্দোলনের সাথে সাম্প্রতিক দিনটি খোলে যাতে আপনার ইতিহাস পর্যালোচনা করা সহজ হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When today has no timeline events, iso.me now opens the most recent day with saved visits or movement so your history is easier to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hoy no tiene eventos en la línea de tiempo, iso.me ahora abre el día más reciente con visitas guardadas o movimiento para que su historial sea más fácil de revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il n'y a pas d'événements chronologiques aujourd'hui, iso.me ouvre désormais le jour le plus récent avec les visites ou les mouvements enregistrés afin que votre historique soit plus facile à consulter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आज कोई टाइमलाइन इवेंट नहीं है, तो iso.me अब सहेजे गए विज़िट या मूवमेंट के साथ सबसे हाल का दिन खोलता है ताकि आपके इतिहास की समीक्षा करना आसान हो जाए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はタイムライン イベントがない場合、 iso.meでは保存された訪問や移動を含む最新の日が開くようになり、履歴を簡単に確認できるようになりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando hoje não há eventos na linha do tempo, iso.me agora abre o dia mais recente com visitas ou movimentos salvos para que seu histórico seja mais fácil de revisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сегодня нет событий временной шкалы, iso.me теперь открывает самый последний день с сохраненными посещениями или перемещениями, чтобы вашу историю было легче просмотреть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当今天没有时间线事件时， iso.me现在会打开最近一天已保存的访问或活动，以便您更轻松地查看历史记录。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dzisiaj nie ma zdarzeń na osi czasu, iso.me otwiera najnowszy dzień z zapisanymi wizytami lub przemieszczeniami, aby ułatwić przeglądanie historii."
          }
        }
      }
    },
    "While a route is recording, use the new Rename Current Outing action in Shortcuts or Siri to name the trip without opening iso.me.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تسجيل المسار، استخدم إجراء إعادة تسمية الرحلة الحالية الجديد في Shortcuts أو Siri لتسمية الرحلة دون فتح iso.me."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি রুট রেকর্ডিং করার সময়, iso.me না খুলেই ট্রিপের নাম দিতে Shortcuts বা Siri এ নতুন রিনেম কারেন্ট আউটিং অ্যাকশন ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a route is recording, use the new Rename Current Outing action in Shortcuts or Siri to name the trip without opening iso.me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se graba una ruta, use la nueva acción Cambiar nombre de la salida actual en Shortcuts o Siri para nombrar el viaje sin abrir iso.me."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant l'enregistrement d'un itinéraire, utilisez la nouvelle action Renommer la sortie en cours dans Shortcuts ou Siri pour nommer le voyage sans ouvrir iso.me."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई मार्ग रिकॉर्डिंग कर रहा हो, तो iso.me खोले बिना यात्रा को नाम देने के लिए Shortcuts या Siri में नए नाम बदलें करंट आउटिंग क्रिया का उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートの記録中に、 ShortcutsまたはSiriの新しい「現在の外出の名前を変更」アクションを使用して、iso.me を開かずに旅行に名前を付けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto uma rota está sendo gravada, use a nova ação Renomear passeio atual em Shortcuts ou Siri para nomear a viagem sem abrir o iso.me."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время записи маршрута используйте новое действие «Переименовать текущий маршрут» в Shortcuts или Siri , чтобы назвать поездку, не открывая iso.me."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录路线时，可以使用Shortcuts或Siri中的新“重命名当前外出”操作来命名行程，而无需打开 iso.me。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas rejestrowania trasy użyj nowej czynności „Zmień nazwę bieżącej podróży” w Skrótach lub Siri, aby nadać jej nazwę bez otwierania iso.me."
          }
        }
      }
    },
