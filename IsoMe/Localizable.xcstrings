          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte las visitas y rutas de IsoMe de ayer como un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez les visites IsoMe d'hier et l'itinéraire sous forme de fichier."
          }
