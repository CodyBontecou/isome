    "All data stored locally. Never uploaded to any server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع البيانات المخزنة محليا. لم يتم التحميل مطلقًا على أي خادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত ডেটা স্থানীয়ভাবে সংরক্ষিত। কোন সার্ভারে আপলোড করা হয়নি."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data stored locally. Never uploaded to any server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos almacenados localmente. Nunca subido a ningún servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données stockées localement. Jamais téléchargé sur un serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी डेटा स्थानीय रूप से संग्रहीत। कभी भी किसी सर्वर पर अपलोड नहीं किया गया."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータはローカルに保存されます。サーバーにアップロードすることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados armazenados localmente. Nunca carregado em nenhum servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные хранятся локально. Никогда не загружался ни на один сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都存储在本地。从未上传到任何服务器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie dane przechowywane lokalnie. Nigdy nie przesyłane na żaden serwer."
          }
        }
      }
    },
