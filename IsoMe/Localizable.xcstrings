            "value": "IsoMe n’enregistre pas de sortie actuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe फिलहाल किसी आउटिंग की रिकॉर्डिंग नहीं कर रहा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe は現在外出を記録していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe não está gravando um passeio no momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe в настоящее время не записывает прогулки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe 当前没有记录外出活动。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe nie rejestruje obecnie podróży."
          }
        }
      }
    },
    "IsoMe isn't tracking right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe لا يتتبع الآن."
          }
        },
        "bn": {
