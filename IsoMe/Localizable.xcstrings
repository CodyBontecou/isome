    "Connect Photos to show pictures on your map and outings. iso.me stores only local photo metadata.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربط الصور لإظهار الصور على خريطتك ونزهاتك. يقوم iso.me بتخزين البيانات التعريفية للصور المحلية فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মানচিত্র এবং আউটিংয়ের ছবিগুলি দেখাতে ফটোগুলিকে সংযুক্ত করুন৷ iso.me শুধুমাত্র স্থানীয় ফটো মেটাডেটা সঞ্চয় করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Photos to show pictures on your map and outings. iso.me stores only local photo metadata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Fotos para mostrar imágenes en tu mapa y salidas. iso.me almacena sólo metadatos de fotografías locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Photos pour afficher des images sur votre carte et vos sorties. iso.me stocke uniquement les métadonnées des photos locales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मानचित्र और सैर पर तस्वीरें दिखाने के लिए फ़ोटो कनेक्ट करें। iso.me केवल स्थानीय फोटो मेटाडेटा संग्रहीत करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を接続すると、地図上や外出先の写真を表示できます。 iso.meローカルの写真メタデータのみを保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte Fotos para mostrar fotos em seu mapa e passeios. iso.me armazena apenas metadados de fotos locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите фотографии, чтобы показывать фотографии на карте и прогулках. iso.me хранит только локальные метаданные фотографий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接照片以在地图和郊游上显示图片。 iso.me仅存储本地照片元数据。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz z biblioteką Zdjęć, aby wyświetlać zdjęcia na mapie i w podróżach. iso.me przechowuje tylko lokalne metadane zdjęć."
          }
        }
      }
    },
