    "OwnTracks format works with Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), and Traccar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل تنسيق OwnTracks مع Dawarich (api/v1/owntracks/points)، ومسجل OwnTracks (/pub)، وTraccar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks ফরম্যাট Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), এবং Traccar-এর সাথে কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks format works with Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), and Traccar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato OwnTracks funciona con Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub) y Traccar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format OwnTracks fonctionne avec Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub) et Traccar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks प्रारूप डावरिच (एपीआई/वी1/ओनट्रैक्स/पॉइंट्स), OwnTracks रिकॉर्डर (/पब) और ट्रैकर के साथ काम करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks形式は、Dawarich (api/v1/owntracks/points)、 OwnTracks Recorder (/pub)、および Traccar で動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato OwnTracks funciona com Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub) e Traccar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат OwnTracks работает с Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub) и Traccar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks格式适用于 Dawarich (api/v1/owntracks/points)、 OwnTracks Recorder (/pub) 和 Traccar。"
          }
        },
        "pl": {
          "stringUnit": {
