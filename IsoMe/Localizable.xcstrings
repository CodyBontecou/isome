    "Manage your lifetime export purchase and Family Sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر شراء التصدير مدى الحياة والمشاركة العائلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইফটাইম এক্সপোর্ট কেনাকাটা ও ফ্যামিলি শেয়ারিং পরিচালনা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage your lifetime export purchase and Family Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona tu compra de exportación de por vida y En familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez votre achat d’export à vie et le partage familial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइफ़टाइम एक्सपोर्ट खरीद और फ़ैमिली शेयरिंग मैनेज करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りの書き出し購入とファミリー共有を管理します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie sua compra vitalícia de exportação e o Compartilhamento Familiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте бессрочным экспортом и Семейным доступом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理终身导出购买和家人共享。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj dożywotnim dostępem do eksportu i Chmurą rodzinną."
          }
        }
      }
    },
    "Export your visits, points, and routes in every supported format. Tracking stays free and unlimited.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر زياراتك ونقاطك ومساراتك بكل التنسيقات المدعومة. يظل التتبع مجانيًا وغير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব সমর্থিত ফরম্যাটে আপনার ভিজিট, পয়েন্ট ও রুট এক্সপোর্ট করুন। ট্র্যাকিং বিনামূল্যে ও সীমাহীন থাকবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your visits, points, and routes in every supported format. Tracking stays free and unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus visitas, puntos y rutas en todos los formatos compatibles. El seguimiento sigue siendo gratuito e ilimitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos visites, points et itinéraires dans tous les formats pris en charge. Le suivi reste gratuit et illimité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने विज़िट, पॉइंट और रूट हर समर्थित फ़ॉर्मैट में एक्सपोर्ट करें। ट्रैकिंग मुफ़्त और असीमित रहेगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問、位置情報、ルートをすべての対応形式で書き出せます。追跡は引き続き無料かつ無制限です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte visitas, pontos e rotas em todos os formatos compatíveis. O rastreamento continua gratuito e ilimitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте посещения, точки и маршруты во всех поддерживаемых форматах. Отслеживание останется бесплатным и безлимитным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以所有支持的格式导出访问、位置点和路线。位置记录仍然免费且不限量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj swoje wizyty, punkty i trasy w każdym obsługiwanym formacie. Śledzenie pozostaje bezpłatne i nieograniczone."
          }
        }
      }
    },
