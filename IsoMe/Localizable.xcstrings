    "Unable to access the export folder. Please reselect it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على الوصول إلى مجلد التصدير. يرجى إعادة تحديده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট ফোল্ডার অ্যাক্সেস করতে অক্ষম. এটি পুনরায় নির্বাচন করুন."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to access the export folder. Please reselect it."
