    "Arrival and departure timestamps are always included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تضمين الطوابع الزمنية للوصول والمغادرة دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগমন এবং প্রস্থান টাইমস্ট্যাম্প সবসময় অন্তর্ভুক্ত করা হয়."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival and departure timestamps are always included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las marcas de tiempo de llegada y salida siempre están incluidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horodatages d’arrivée et de départ sont toujours inclus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगमन और प्रस्थान टाइमस्टैम्प हमेशा शामिल होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着および出発のタイムスタンプが常に含まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os carimbos de data e hora de chegada e partida estão sempre incluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные метки прибытия и отправления всегда включены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终包含到达和出发时间戳。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze uwzględniane są znaczniki czasu przyjazdu i wyjazdu."
          }
        }
      }
    },
    "Arrivals, durations, and changes throughout your day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول والمدد والتغييرات طوال يومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
