    "iso.me has a refreshed app icon and updated release polish across the app experience.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي iso.me على أيقونة تطبيق محدثة وإصدار محدث عبر تجربة التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me অ্যাপের অভিজ্ঞতা জুড়ে একটি রিফ্রেশড অ্যাপ আইকন এবং আপডেট করা রিলিজ পলিশ রয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me has a refreshed app icon and updated release polish across the app experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me tiene un ícono de aplicación actualizado y un pulido de lanzamiento actualizado en toda la experiencia de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me a une icône d'application actualisée et une version mise à jour dans toute l'expérience de l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me में एक ताज़ा ऐप आइकन और ऐप अनुभव में अपडेटेड रिलीज़ पॉलिश है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.meでは、アプリ アイコンが更新され、アプリ エクスペリエンス全体のリリースが更新されました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me tem um ícone de aplicativo atualizado e uma versão atualizada em toda a experiência do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me имеет обновленный значок приложения и обновленную версию приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me更新了应用程序图标，并更新了整个应用程序体验的发布版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me ma odświeżoną ikonę aplikacji i zaktualizowane wydanie w całej aplikacji."
          }
        }
      }
    },
    "iso.me stores only this photo's local identifier, timestamp, and coordinates. The photo file stays in your Photos library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم iso.me بتخزين المعرف المحلي لهذه الصورة والطابع الزمني والإحداثيات فقط. يبقى ملف الصورة في مكتبة الصور الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me শুধুমাত্র এই ছবির স্থানীয় শনাক্তকারী, টাইমস্ট্যাম্প এবং স্থানাঙ্ক সংরক্ষণ করে। ফটো ফাইলটি আপনার ফটো লাইব্রেরিতে থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me stores only this photo's local identifier, timestamp, and coordinates. The photo file stays in your Photos library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me almacena sólo el identificador local, la marca de tiempo y las coordenadas de esta foto. El archivo de la foto permanece en su biblioteca de Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me stocke uniquement l'identifiant local, l'horodatage et les coordonnées de cette photo. Le fichier photo reste dans votre bibliothèque Photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me केवल इस फोटो के स्थानीय पहचानकर्ता, टाइमस्टैम्प और निर्देशांक को संग्रहीत करता है। फ़ोटो फ़ाइल आपकी फ़ोटो लाइब्रेरी में रहती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me 、この写真のローカル識別子、タイムスタンプ、および座標のみを保存します。写真ファイルは写真ライブラリに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me armazena apenas o identificador local, carimbo de data/hora e coordenadas desta foto. O arquivo da foto permanece na sua biblioteca de fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me хранит только локальный идентификатор, временную метку и координаты этой фотографии. Файл фотографии останется в вашей библиотеке фотографий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me仅存储该照片的本地标识符、时间戳和坐标。照片文件保留在您的照片库中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me przechowuje tylko lokalny identyfikator, znacznik czasu i współrzędne tego zdjęcia. Plik zdjęcia pozostanie w Twojej bibliotece Zdjęć."
          }
        }
      }
    },
    "iso.me uses your location to detect places you visit and trace your daily path.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم iso.me موقعك لاكتشاف الأماكن التي تزورها وتتبع مسارك اليومي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me আপনার লোকেশন ব্যবহার করে আপনি যেসব জায়গায় যান এবং আপনার প্রতিদিনের পথ খুঁজে বের করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me uses your location to detect places you visit and trace your daily path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me utiliza tu ubicación para detectar los lugares que visitas y rastrear tu ruta diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me utilise votre localisation pour détecter les lieux que vous visitez et tracer votre parcours quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me आपके स्थान का उपयोग उन स्थानों का पता लगाने के लिए करता है जहां आप जाते हैं और आपके दैनिक पथ का पता लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.meあなたの位置情報を使用して、あなたが訪れた場所を検出し、毎日の経路を追跡します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me usa sua localização para detectar lugares que você visita e traçar sua trajetória diária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me использует ваше местоположение, чтобы определять места, которые вы посещаете, и отслеживать ваш ежедневный путь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me使用您的位置来检测您访问的地点并追踪您的日常路径。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me wykorzystuje Twoją lokalizację do wykrywania odwiedzanych miejsc i śledzenia Twojej codziennej ścieżki."
          }
        }
      }
    },
    "IsoMe is not currently recording an outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe لا يقوم حاليًا بتسجيل نزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe বর্তমানে একটি আউটিং রেকর্ড করছে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe is not currently recording an outing."
          }
        },
        "es": {
