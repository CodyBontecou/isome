          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les visites consignées par IsoMe dans une plage de dates choisie. Par défaut, aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई तिथि सीमा में IsoMe द्वारा लॉग की गई विज़िट। डिफ़ॉल्ट रूप से आज।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日付範囲にIsoMeが記録した訪問。デフォルトは今日です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As visitas que o IsoMe registrou em um período escolhido. O padrão é hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посещения, записанные IsoMe за выбранный диапазон дат. По умолчанию — сегодня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe 在选定日期范围内记录的访问。默认为今天。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizyty zarejestrowane przez IsoMe w wybranym zakresie dat. Domyślnie: dzisiaj."
          }
        }
      }
    },
    "There is no data for the selected export settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات لإعدادات التصدير المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত রপ্তানি সেটিংসের জন্য কোন ডেটা নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no data for the selected export settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos para la configuración de exportación seleccionada."
          }
        },
        "fr": {
