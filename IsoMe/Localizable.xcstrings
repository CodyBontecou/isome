    "Uses Apple Maps routes to bend sparse GPS gaps onto nearby roads when possible, instead of drawing rough point-to-point lines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم مسارات Apple Maps لسد فجوات GPS المتفرقة على الطرق القريبة عندما يكون ذلك ممكنًا، بدلاً من رسم خطوط تقريبية من نقطة إلى نقطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোটামুটি পয়েন্ট-টু-পয়েন্ট লাইন আঁকার পরিবর্তে, সম্ভব হলে কাছের রাস্তায় বিক্ষিপ্ত GPS ফাঁক বাঁকানোর জন্য Apple Maps রুট ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Maps routes to bend sparse GPS gaps onto nearby roads when possible, instead of drawing rough point-to-point lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza rutas Apple Maps para doblar los escasos espacios GPS hacia carreteras cercanas cuando sea posible, en lugar de dibujar líneas toscas de punto a punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les itinéraires Apple Maps pour combler les lacunes GPS clairsemées sur les routes à proximité lorsque cela est possible, au lieu de tracer des lignes approximatives point à point."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी संभव हो, खुरदरी बिंदु-से-बिंदु रेखाएँ खींचने के बजाय, आस-पास की सड़कों पर विरल GPS अंतराल को मोड़ने के लिए Apple Maps मार्गों का उपयोग करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Mapsルートを使用して、大まかなポイント間の線を描くのではなく、可能であれば近くの道路にまばらなGPSギャップを曲げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa rotas Apple Maps para desviar lacunas esparsas GPS em estradas próximas quando possível, em vez de desenhar linhas ásperas ponto a ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует маршруты Apple Maps , чтобы по возможности совместить редкие промежутки GPS с близлежащими дорогами, вместо рисования грубых линий из двух точек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能使用Apple Maps路线将稀疏的GPS间隙弯曲到附近的道路上，而不是绘制粗糙的点对点线。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowuje trasę do pobliskich dróg przy użyciu Map Apple, gdy między punktami GPS są luki, zamiast łączyć punkty prostymi liniami."
          }
        }
      }
    },
    "Uses photo GPS when available, otherwise matches timestamps to nearby route points or visits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GPS للصور عندما يكون متاحًا، وإلا فإنه يطابق الطوابع الزمنية لنقاط الطريق أو الزيارات القريبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপলব্ধ হলে ফটো GPS ব্যবহার করে, অন্যথায় কাছাকাছি রুট পয়েন্ট বা ভিজিটের সাথে টাইমস্ট্যাম্প মেলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses photo GPS when available, otherwise matches timestamps to nearby route points or visits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza GPS fotográfico cuando está disponible; de ​​lo contrario, compara marcas de tiempo con puntos de ruta o visitas cercanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise GPS photo lorsqu'il est disponible, sinon fait correspondre les horodatages aux points d'itinéraire ou aux visites à proximité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध होने पर फोटो GPS उपयोग करता है, अन्यथा पास के मार्ग बिंदुओं या यात्राओं के टाइमस्टैम्प का मिलान करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合は写真GPSを使用し、そうでない場合はタイムスタンプを近くのルート ポイントまたは訪問先と照合します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa GPS fotográfico quando disponível, caso contrário, combina carimbos de data/hora com pontos de rota ou visitas próximos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует фото GPS если таковой имеется, в противном случае сопоставляет временные метки с близлежащими точками маршрута или посещениями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果可用，则使用照片GPS ，否则将时间戳与附近的路线点或访问进行匹配。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa danych GPS zdjęcia, a jeśli ich brakuje — dopasowuje czas wykonania do pobliskich punktów trasy lub wizyt."
          }
        }
      }
    },
