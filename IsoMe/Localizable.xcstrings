    "Point %lld of %lld. Time %@. Elapsed %@ of %@. Distance %@ of %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقطة %1$lld من %2$lld . الوقت %3$@ . المنقضي %4$@ من %5$@ . المسافة %6$@ من %7$@ ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %2$lld পয়েন্ট। সময় %3$@ %4$@ %5$@ অতিবাহিত হয়েছে। দূরত্ব %6$@ এর মধ্যে %7$@ ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %1$lld of %2$lld. Time %3$@. Elapsed %4$@ of %5$@. Distance %6$@ of %7$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto %1$lld de %2$lld . Hora %3$@ . %4$@ transcurrido de %5$@ . Distancia %6$@ de %7$@ ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %1$lld de %2$lld . Heure %3$@ . %4$@ écoulé sur %5$@ . Distance %6$@ de %7$@ ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld का बिंदु %2$lld . समय %3$@ . % %5$@ %4$@ @ बीत गया। दूरी %6$@ में से %7$@ ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "% %1$lld %2$lld 。時刻%3$@ 。 %4$@ %5$@が経過しました。 %6$@ %7$@ 。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto %1$lld de %2$lld . Hora %3$@ . %4$@ decorrido de %5$@ . Distância %6$@ de %7$@ ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точка %1$lld из %2$lld . Время %3$@ . Прошло %4$@ из %5$@ . Расстояние %6$@ из %7$@ ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
