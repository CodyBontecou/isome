    "Filtered data is condensed into one file per selected format.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تكثيف البيانات التي تمت تصفيتها في ملف واحد لكل تنسيق محدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিল্টার করা ডেটা প্রতি নির্বাচিত বিন্যাসে একটি ফাইলে ঘনীভূত হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtered data is condensed into one file per selected format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos filtrados se condensan en un archivo por formato seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données filtrées sont condensées en un seul fichier par format sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर किए गए डेटा को प्रत्येक चयनित प्रारूप में एक फ़ाइल में संघनित किया जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタリングされたデータは、選択した形式ごとに 1 つのファイルに圧縮されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados filtrados são condensados ​​em um arquivo por formato selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отфильтрованные данные сжимаются в один файл выбранного формата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤后的数据按照选定的格式压缩为一个文件。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przefiltrowane dane są kondensowane w jednym pliku w wybranym formacie."
