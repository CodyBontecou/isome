    "Let iso.me automatically show iPhone photos on your map and outings. Photos stay in your Photos library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ iso.me بعرض صور iPhone تلقائيًا على خريطتك ونزهاتك. تبقى الصور في مكتبة الصور الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me স্বয়ংক্রিয়ভাবে আপনার মানচিত্র এবং আউটিং-এ iPhone ফটোগুলি দেখাতে দিন। ফটোগুলি আপনার ফটো লাইব্রেরিতে থাকে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let iso.me automatically show iPhone photos on your map and outings. Photos stay in your Photos library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje que iso.me muestre automáticamente fotos iPhone en su mapa y salidas. Las fotos permanecen en tu biblioteca de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez iso.me afficher automatiquement les photos iPhone sur votre carte et vos sorties. Les photos restent dans votre bibliothèque de photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me स्वचालित रूप से आपके मानचित्र और सैर पर iPhone फ़ोटो दिखाने दें। तस्वीरें आपकी फ़ोटो लाइब्रेरी में रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iso.me使用すると、 iPhone写真が地図や外出先上に自動的に表示されます。写真は写真ライブラリに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe iso.me mostrar automaticamente as fotos iPhone no seu mapa e passeios. As fotos permanecem na sua biblioteca de fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите iso.me автоматически показывать фотографии iPhone на вашей карте и во время прогулок. Фотографии остаются в вашей библиотеке фотографий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让iso.me自动在您的地图和郊游中显示iPhone照片。照片保留在您的照片库中。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól iso.me automatycznie pokazywać zdjęcia z iPhone’a na mapie i w podróżach. Zdjęcia pozostają w bibliotece Zdjęć."
          }
        }
      }
    },
    "Limit the export to a specific window of time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصر التصدير على فترة زمنية محددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রপ্তানিকে নির্দিষ্ট সময়ের মধ্যে সীমাবদ্ধ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit the export to a specific window of time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite la exportación a un período de tiempo específico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitez l’exportation à une fenêtre de temps spécifique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात को समय की एक विशिष्ट विंडो तक सीमित करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートを特定の時間枠に制限します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite a exportação a uma janela de tempo específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничьте экспорт определенным периодом времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将导出限制在特定的时间范围内。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicz eksport do określonego okna czasowego."
          }
        }
      }
    },
