    "Choose where the visit happened. Your current GPS location will not be used.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان حدوث الزيارة. لن يتم استخدام موقع GPS الحالي الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে পরিদর্শন ঘটেছে চয়ন করুন। আপনার বর্তমান GPS অবস্থান ব্যবহার করা হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where the visit happened. Your current GPS location will not be used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija dónde ocurrió la visita. No se utilizará su ubicación GPS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où la visite a eu lieu. Votre position GPS actuelle ne sera pas utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यात्रा कहाँ हुई। आपके वर्तमान GPS स्थान का उपयोग नहीं किया जाएगा."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問が行われた場所を選択してください。現在のGPS位置情報は使用されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde a visita aconteceu. Sua localização GPS atual não será usada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где произошел визит. Ваше текущее местоположение GPS не будет использоваться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择访问发生的地点。您当前的GPS位置将不会被使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miejsce, w którym odbyła się wizyta. Twoja bieżąca lokalizacja GPS nie zostanie użyta."
          }
        }
      }
    },
