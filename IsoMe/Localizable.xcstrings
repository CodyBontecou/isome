    "Show tracking progress on the Lock Screen and Dynamic Island. Your choice is saved for future tracking sessions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار تقدم التتبع على شاشة القفل والجزيرة الديناميكية. يتم حفظ اختيارك لجلسات التتبع المستقبلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক স্ক্রীন এবং ডায়নামিক দ্বীপে ট্র্যাকিং অগ্রগতি দেখান। আপনার পছন্দ ভবিষ্যতের ট্র্যাকিং সেশনের জন্য সংরক্ষিত হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show tracking progress on the Lock Screen and Dynamic Island. Your choice is saved for future tracking sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el progreso del seguimiento en la pantalla de bloqueo y en la isla dinámica. Su elección se guarda para futuras sesiones de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la progression du suivi sur l'écran de verrouillage et Dynamic Island. Votre choix est enregistré pour les futures sessions de suivi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन और डायनेमिक आइलैंड पर ट्रैकिंग प्रगति दिखाएं। आपकी पसंद भविष्य के ट्रैकिंग सत्रों के लिए सहेजी गई है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面とダイナミックアイランドに追跡の進行状況を表示します。選択内容は、今後の追跡セッションのために保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o progresso do rastreamento na tela de bloqueio e na ilha dinâmica. Sua escolha é salva para futuras sessões de rastreamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать прогресс отслеживания на экране блокировки и в динамическом острове. Ваш выбор сохраняется для будущих сеансов отслеживания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕和动态岛上显示跟踪进度。您的选择将被保存以供将来的跟踪会话使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj postęp śledzenia na ekranie blokady i w Dynamic Island. Twój wybór zostanie zapamiętany dla kolejnych sesji."
          }
        }
      }
    },
    "Showing a lightweight preview of this %@ file. The full export will still include all data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض معاينة خفيفة لهذا الملف %@ . سيظل التصدير الكامل يتضمن جميع البيانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %@ ফাইলের একটি হালকা পূর্বরূপ দেখানো হচ্ছে। সম্পূর্ণ রপ্তানি এখনও সমস্ত ডেটা অন্তর্ভুক্ত করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing a lightweight preview of this %@ file. The full export will still include all data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando una vista previa ligera de este archivo %@ . La exportación completa seguirá incluyendo todos los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage d'un aperçu léger de ce fichier %@ . L’exportation complète inclura toujours toutes les données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस %@ फ़ाइल का हल्का पूर्वावलोकन दिखाया जा रहा है। पूर्ण निर्यात में अभी भी सभी डेटा शामिल होंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%@ファイルの軽量プレビューを表示しています。完全なエクスポートにはすべてのデータが含まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando uma prévia leve deste arquivo %@ . A exportação completa ainda incluirá todos os dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показан упрощенный предварительный просмотр этого файла %@ . Полный экспорт по-прежнему будет включать все данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示此%@文件的轻量级预览。完整导出仍将包含所有数据。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlam uproszczony podgląd tego pliku %@. Pełny eksport nadal będzie zawierał wszystkie dane."
          }
        }
      }
    },
    "Shown": {
