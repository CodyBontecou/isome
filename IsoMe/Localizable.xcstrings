    "Names and notes stay on-device with the recording session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأسماء والملاحظات على الجهاز أثناء جلسة التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম এবং নোট রেকর্ডিং সেশনের সাথে ডিভাইসে থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and notes stay on-device with the recording session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y las notas permanecen en el dispositivo durante la sesión de grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et les notes restent sur l'appareil pendant la session d'enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग सत्र के साथ नाम और नोट्स डिवाइस पर बने रहते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前とメモは、記録セッションとともにデバイス上に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e notas permanecem no dispositivo durante a sessão de gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена и заметки остаются на устройстве во время сеанса записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
