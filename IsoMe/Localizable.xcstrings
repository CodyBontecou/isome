    "No photos with GPS metadata or a nearby iso.me route/visit match were found during this outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أي صور تحتوي على بيانات تعريف GPS أو تطابق مسار/زيارة iso.me قريب أثناء هذه النزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আউটিং চলাকালীন GPS মেটাডেটা সহ কোনো ছবি বা কাছাকাছি কোনো iso.me রুট/ভিজিট ম্যাচ পাওয়া যায়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos with GPS metadata or a nearby iso.me route/visit match were found during this outing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante esta salida no se encontraron fotos con metadatos GPS o una coincidencia de ruta/visita iso.me cercana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo avec métadonnées GPS ou correspondance itinéraire/visite iso.me à proximité n'a été trouvée lors de cette sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सैर के दौरान GPS मेटाडेटा या नजदीकी iso.me रूट/विज़िट मैच वाली कोई तस्वीर नहीं मिली।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この外出中に、 GPSメタデータを含む写真や、近くのiso.meルート/訪問地に一致する写真は見つかりませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma foto com metadados GPS ou correspondência de rota/visita iso.me próxima foi encontrada durante este passeio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время этой прогулки не было обнаружено фотографий с метаданными GPS или близлежащим маршрутом/посещением iso.me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次郊游期间未找到带有GPS数据或附近iso.me路线/访问匹配的照片。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zdjęć z tej podróży z danymi GPS ani zdjęć pasujących do pobliskich punktów trasy lub wizyt w iso.me."
          }
        }
      }
    },
