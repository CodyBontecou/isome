        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe को स्थान अनुमति की आवश्यकता है. इसे सक्षम करने के लिए ऐप खोलें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IsoMe には位置情報の許可が必要です。アプリを開いて有効にします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
