        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które już dokonały zakupu, mogą zweryfikować go w Ustawieniach i zalogować się do myself.md, aby odebrać bezpłatny dożywotni dostęp."
          }
        }
      }
    },
    "Explore all matching photos in each group, or use Browse Photo Places to find locations beyond the markers currently shown on the map.": {
      "localizations": {
