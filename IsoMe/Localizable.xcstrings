      }
    },
    "This format exports an outing summary with timing, distance, visit count, notes, and coordinates.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم هذا التنسيق بتصدير ملخص الرحلة مع التوقيت والمسافة وعدد الزيارات والملاحظات والإحداثيات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিন্যাসটি সময়, দূরত্ব, ভিজিট কাউন্ট, নোট এবং স্থানাঙ্ক সহ একটি আউটিং সারাংশ রপ্তানি করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format exports an outing summary with timing, distance, visit count, notes, and coordinates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato exporta un resumen de la salida con tiempo, distancia, recuento de visitas, notas y coordenadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format exporte un résumé de sortie avec le temps, la distance, le nombre de visites, les notes et les coordonnées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रारूप समय, दूरी, विज़िट संख्या, नोट्स और निर्देशांक के साथ एक आउटिंग सारांश निर्यात करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式では、タイミング、距離、訪問回数、メモ、座標を含む外出の概要をエクスポートします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato exporta um resumo do passeio com tempo, distância, contagem de visitas, notas e coordenadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом формате экспортируется сводная информация о поездке с указанием времени, расстояния, количества посещений, примечаний и координат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式导出包含时间、距离、访问次数、注释和坐标的外出摘要。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten format umożliwia eksportowanie podsumowania podróży zawierającego czas, dystans, liczbę wizyt, notatki i współrzędne."
          }
        }
      }
    },
    "This is optional — skip it if you only want location visits and routes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعد هذا أمرًا اختياريًا — قم بتخطيه إذا كنت تريد زيارات الموقع والمسارات فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ঐচ্ছিক — আপনি যদি শুধুমাত্র অবস্থান পরিদর্শন এবং রুট চান তাহলে এটি এড়িয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is optional — skip it if you only want location visits and routes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es opcional; omítelo si solo deseas visitas a ubicaciones y rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est facultatif – ignorez-le si vous souhaitez uniquement des visites et des itinéraires sur place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वैकल्पिक है - यदि आप केवल स्थान विज़िट और मार्ग चाहते हैं तो इसे छोड़ दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはオプションです。場所の訪問とルートのみが必要な場合はスキップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é opcional – pule-o se quiser apenas visitas e rotas locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это необязательно — пропустите его, если вам нужны только посещения мест и маршруты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是可选的 - 如果您只想进行地点访问和路线，请跳过它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten krok jest opcjonalny — pomiń go, jeśli chcesz rejestrować tylko wizyty i trasy."
          }
        }
      }
    },
