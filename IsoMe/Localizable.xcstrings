            "value": "الحفظ على أي حال"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তবুও সংরক্ষণ করুন"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar de todos modos"
          }
        },
        "fr": {
