    "Every place is listed here, even outside the visible map. Area annotations group places for rendering; they do not represent one shared location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every place is listed here, even outside the visible map. Area annotations group places for rendering; they do not represent one shared location."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj znajdziesz wszystkie miejsca, także poza widocznym obszarem mapy. Znaczniki obszarów grupują miejsca na potrzeby wyświetlania; nie oznaczają jednej wspólnej lokalizacji."
          }
        }
      }
    },
    "Existing purchasers can verify their purchase in Settings and sign in to myself.md to claim complimentary lifetime access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing purchasers can verify their purchase in Settings and sign in to myself.md to claim complimentary lifetime access."
