    "Place prompts stay dismissed around the same area, and add-place controls step out of the way while filters are open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل مطالبات المكان مرفوضة حول نفس المنطقة، وتختفي عناصر التحكم في إضافة مكان أثناء فتح عوامل التصفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লেস প্রম্পট একই এলাকার আশেপাশে খারিজ হয়ে যায় এবং ফিল্টার খোলা থাকাকালীন অ্যাড-প্লেস কন্ট্রোলগুলি সরে যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place prompts stay dismissed around the same area, and add-place controls step out of the way while filters are open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las indicaciones de lugar permanecen descartadas en la misma área y los controles de agregar lugar se apartan mientras los filtros están abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invites de lieu restent ignorées autour de la même zone et les contrôles d'ajout de lieu s'écartent lorsque les filtres sont ouverts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेस प्रॉम्प्ट उसी क्षेत्र के आसपास ख़ारिज हो जाते हैं, और फ़िल्टर खुले होने पर ऐड-प्लेस नियंत्रण रास्ते से हट जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターが開いている間、配置プロンプトは同じエリアの周囲で閉じられたままになり、追加/配置コントロールは邪魔になりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prompts de local permanecem ignorados na mesma área e os controles de adição de local ficam fora do caminho enquanto os filtros estão abertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки о месте остаются скрытыми в той же области, а элементы управления добавлением места уходят в сторону, пока фильтры открыты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一区域周围的地点提示保持关闭状态，并且在过滤器打开时，添加地点控件会退出。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucone sugestie miejsc nie pojawiają się ponownie w tej samej okolicy, a przyciski dodawania miejsc są ukrywane, gdy filtry są otwarte."
          }
        }
      }
    },
