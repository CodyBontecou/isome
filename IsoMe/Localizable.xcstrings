    "Future automatic visits within this radius will use this name before network geocoding.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم الزيارات التلقائية المستقبلية داخل هذا النطاق هذا الاسم قبل الترميز الجغرافي للشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যাসার্ধের মধ্যে ভবিষ্যত স্বয়ংক্রিয় পরিদর্শনগুলি নেটওয়ার্ক জিওকোডিংয়ের আগে এই নামটি ব্যবহার করবে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future automatic visits within this radius will use this name before network geocoding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las visitas automáticas futuras dentro de este radio utilizarán este nombre antes de la codificación geográfica de la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les futures visites automatiques dans ce rayon utiliseront ce nom avant le géocodage du réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दायरे में भविष्य की स्वचालित विज़िट नेटवर्क जियोकोडिंग से पहले इस नाम का उपयोग करेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後、この半径内の自動訪問では、ネットワーク ジオコーディングの前にこの名前が使用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Futuras visitas automáticas dentro deste raio usarão este nome antes da geocodificação da rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будущие автоматические посещения в этом радиусе будут использовать это имя перед сетевым геокодированием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来在此半径内的自动访问将在网络地​​理编码之前使用此名称。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyszłe automatyczne wizyty w tym promieniu użyją zapisanej nazwy przed geokodowaniem przez sieć."
          }
        }
      }
    },
