            "state": "translated",
            "value": "शुरू होने के समय के अनुसार मूवमेंट ढूँढता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻で移動を検索します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra movimentos de acordo com a hora em que começaram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит перемещения по времени их начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据开始时间查找移动。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje przemieszczenia według czasu rozpoczęcia."
          }
        }
      }
    },
