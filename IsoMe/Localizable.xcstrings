    "Overlays the route for the tracking session that is currently running, separate from the historical date-range path.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتراكب المسار لجلسة التتبع الجاري تشغيلها حاليًا، بشكل منفصل عن مسار النطاق الزمني التاريخي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাকিং সেশনের জন্য রুট ওভারলে করে যা বর্তমানে চলছে, ঐতিহাসিক তারিখ-পরিসরের পথ থেকে আলাদা।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlays the route for the tracking session that is currently running, separate from the historical date-range path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpone la ruta de la sesión de seguimiento que se está ejecutando actualmente, separada de la ruta histórica del rango de fechas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose l'itinéraire de la session de suivi en cours d'exécution, distinct du chemin de plage de dates historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐतिहासिक दिनांक-सीमा पथ से अलग, वर्तमान में चल रहे ट्रैकिंग सत्र के लिए रूट को ओवरले करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の日付範囲パスとは別に、現在実行中の追跡セッションのルートをオーバーレイします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe a rota da sessão de rastreamento que está em execução no momento, separada do caminho histórico do intervalo de datas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накладывает маршрут текущего сеанса отслеживания отдельно от исторического пути диапазона дат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖当前正在运行的跟踪会话的路线，与历史日期范围路径分开。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakłada trasę aktualnie uruchomionej sesji śledzenia, oddzielnie od historycznej ścieżki zakresu dat."
          }
        }
      }
    },
