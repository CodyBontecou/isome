    "Apple Maps search is unavailable right now. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث Apple Maps غير متاح حاليًا. يرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps অনুসন্ধান এই মুহূর্তে অনুপলব্ধ৷ আবার চেষ্টা করুন."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps search is unavailable right now. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda Apple Maps no está disponible en este momento. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche Apple Maps n'est pas disponible pour le moment. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps खोज अभी उपलब्ध नहीं है। कृपया पुन: प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、 Apple Maps検索は利用できません。もう一度試してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa Apple Maps não está disponível no momento. Por favor, tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск Apple Maps сейчас недоступен. Пожалуйста, попробуйте еще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps搜索目前不可用。请再试一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie Apple Maps jest obecnie niedostępne. Spróbuj ponownie."
          }
        }
      }
    },
