    "Photo access is off. Enable it in Settings to show photo pins on the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الوصول إلى الصور. قم بتمكينه في الإعدادات لإظهار دبابيس الصور على الخريطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো অ্যাক্সেস বন্ধ আছে. মানচিত্রে ফটো পিনগুলি দেখাতে সেটিংসে এটি সক্ষম করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is off. Enable it in Settings to show photo pins on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a fotografías está desactivado. Habilítelo en Configuración para mostrar pines de fotos en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux photos est désactivé. Activez-le dans Paramètres pour afficher les épingles photo sur la carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो पहुंच बंद है. मानचित्र पर फोटो पिन दिखाने के लिए इसे सेटिंग्स में सक्षम करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスはオフになっています。設定で有効にすると、地図上に写真ピンが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso às fotos está desativado. Ative-o em Configurações para mostrar alfinetes de fotos no mapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фотографиям закрыт. Включите эту функцию в настройках, чтобы показывать фотографии на карте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片访问已关闭。在“设置”中启用它以在地图上显示照片图钉。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do zdjęć jest wyłączony. Włącz tę opcję w Ustawieniach, aby wyświetlać pinezki ze zdjęciami na mapie."
          }
        }
      }
    },
