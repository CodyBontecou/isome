    "Export payload for %@ was not valid UTF-8 text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمولة التصدير لـ %@ لم تكن نص UTF-8 صالحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এর জন্য এক্সপোর্ট পেলোড বৈধ UTF-8 পাঠ্য ছিল না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export payload for %@ was not valid UTF-8 text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga útil de exportación para %@ no era texto UTF-8 válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge utile d'exportation pour %@ n'était pas un texte UTF-8 valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए निर्यात पेलोड वैध UTF-8 टेक्स्ट नहीं था।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のエクスポート ペイロードは有効な UTF-8 テキストではありませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga útil de exportação para %@ não era um texto UTF-8 válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортировать полезные данные для %@ недопустимый текст UTF-8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的导出负载不是有效的 UTF-8 文本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowany ładunek dla %@ nie był prawidłowym tekstem w formacie UTF-8."
          }
        }
      }
    },
