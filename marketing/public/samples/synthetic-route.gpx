<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="iso.me documentation example" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Synthetic route example</name>
    <desc>Invented coordinates and timestamps for learning the GPX format. Not a real trip or a captured app export.</desc>
    <time>2000-01-01T12:00:00Z</time>
  </metadata>
  <trk>
    <name>Synthetic three-point track</name>
    <desc>Example points near latitude zero and longitude zero.</desc>
    <trkseg>
      <trkpt lat="0.0000000" lon="0.0000000"><time>2000-01-01T12:00:00Z</time></trkpt>
      <trkpt lat="0.0001000" lon="0.0001000"><time>2000-01-01T12:01:00Z</time></trkpt>
      <trkpt lat="0.0002000" lon="0.0001000"><time>2000-01-01T12:02:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
