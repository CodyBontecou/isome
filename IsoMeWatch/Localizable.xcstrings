    "Enable location to track directly on Apple Watch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location to track directly on Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين الموقع للتتبع مباشرة على Apple Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch এ সরাসরি ট্র্যাক করতে অবস্থান সক্ষম করুন৷"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite la ubicación para rastrear directamente en Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la localisation pour suivre directement sur Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे Apple Watch पर स्थान ट्रैक करने के लिए सक्षम करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch で位置情報を直接追跡できるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a localização para rastrear diretamente no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите отслеживание местоположения прямо на Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用位置以直接在 Apple Watch 上进行跟踪。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz śledzenie lokalizacji bezpośrednio na Apple Watch."
          }
        }
      }
    },
