    "Location is denied. Enable it in Settings to track from Apple Watch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is denied. Enable it in Settings to track from Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الموقع. قم بتمكينه في الإعدادات للتتبع من Apple Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অস্বীকার করা হয়. Apple Watch থেকে ট্র্যাক করতে সেটিংসে এটি সক্ষম করুন৷"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación es denegada. Habilítelo en Configuración para realizar un seguimiento desde Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est refusée. Activez-le dans Paramètres pour suivre depuis Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान अस्वीकार किया गया है. Apple वॉच से ट्रैक करने के लिए इसे सेटिंग्स में सक्षम करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が拒否されました。 Apple Watchから追跡するには、設定で有効にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização foi negada. Ative-o em Configurações para rastrear no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение отклонено. Включите его в настройках, чтобы отслеживать с Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置被拒绝。在“设置”中启用它以从 Apple Watch 进行跟踪。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja została odrzucona. Włącz tę opcję w Ustawieniach, aby śledzić z Apple Watch."
          }
        }
      }
    },
