    "View your tracking status and today's stats.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض حالة التتبع الخاصة بك وإحصائيات اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্র্যাকিং অবস্থা এবং আজকের পরিসংখ্যান দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View your tracking status and today's stats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea su estado de seguimiento y las estadísticas de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre statut de suivi et les statistiques du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी ट्रैकिंग स्थिति और आज के आँकड़े देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡ステータスと今日の統計を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seu status de rastreamento e as estatísticas de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте статус отслеживания и сегодняшнюю статистику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看您的跟踪状态和今天的统计数据。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź swój status śledzenia i dzisiejsze statystyki."
          }
        }
      }
    }
  },
  "version": "1.0"
}
